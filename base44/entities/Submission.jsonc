{
  "name": "Submission",
  "type": "object",
  "properties": {
    "image_url": {
      "type": "string",
      "description": "URL of the submitted image"
    },
    "task_id": {
      "type": "string",
      "description": "ID of the task this submission is for"
    },
    "user_id": {
      "type": "string",
      "description": "ID of the user who submitted"
    },
    "user_name": {
      "type": "string",
      "description": "Display name of the submitter"
    },
    "community_votes": {
      "type": "number",
      "default": 0,
      "description": "Number of community upvotes"
    },
    "voters": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of user IDs who voted"
    },
    "caption": {
      "type": "string",
      "description": "Optional caption for the submission"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "archived",
        "buried"
      ],
      "default": "active",
      "description": "Status of the submission"
    }
  },
  "required": [
    "image_url",
    "task_id",
    "user_id"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "user_condition": {
        "id": {
          "$exists": true
        }
      }
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}