{
  "name": "WebhookConfig",
  "type": "object",
  "properties": {
    "url": {
      "type": "string",
      "description": "The HTTP endpoint to POST events to"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of event keys this webhook subscribes to"
    },
    "label": {
      "type": "string",
      "description": "Optional friendly name for this webhook"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this webhook is enabled"
    },
    "last_triggered_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of the last successful dispatch"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description of this webhook's purpose"
    }
  },
  "required": [
    "url",
    "events"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}