{
  "name": "Comment",
  "type": "object",
  "properties": {
    "submission_id": {
      "type": "string",
      "description": "ID of the submission this comment belongs to"
    },
    "user_id": {
      "type": "string",
      "description": "ID of the user who posted the comment"
    },
    "alter_ego": {
      "type": "string",
      "description": "Alter-ego name of the commenter at time of posting"
    },
    "avatar_color": {
      "type": "string",
      "description": "Avatar color of the commenter at time of posting"
    },
    "text": {
      "type": "string",
      "description": "Comment text content"
    }
  },
  "required": [
    "submission_id",
    "user_id",
    "text"
  ]
}