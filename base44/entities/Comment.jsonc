{
  "name": "Comment",
  "type": "object",
  "properties": {
    "submission_id": {
      "type": "string",
      "description": "ID of the submission this comment belongs to"
    },
    "user_id": {
      "type": "string",
      "description": "ID of the user who posted the comment"
    },
    "alter_ego": {
      "type": "string",
      "description": "Alter-ego name of the commenter at time of posting"
    },
    "avatar_color": {
      "type": "string",
      "description": "Avatar color of the commenter at time of posting"
    },
    "text": {
      "type": "string",
      "description": "Comment text content"
    }
  },
  "required": [
    "submission_id",
    "user_id",
    "text"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "user_condition": {
        "id": {
          "$exists": true
        }
      }
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}