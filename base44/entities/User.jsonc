{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "total_points": {
      "type": "number",
      "default": 0,
      "description": "Total points earned by the user"
    },
    "latitude": {
      "type": "number",
      "description": "User's last known latitude"
    },
    "longitude": {
      "type": "number",
      "description": "User's last known longitude"
    },
    "bio": {
      "type": "string",
      "description": "Short user bio"
    },
    "avatar_url": {
      "type": "string",
      "description": "Profile avatar URL"
    },
    "alter_ego": {
      "type": "string",
      "description": "User's alter-ego display name"
    },
    "avatar_color": {
      "type": "string",
      "enum": [
        "red",
        "orange",
        "amber",
        "emerald",
        "teal",
        "sky",
        "violet",
        "pink"
      ],
      "default": "sky",
      "description": "Color theme for the user's avatar badge"
    }
  },
  "required": []
}