{
  "name": "Activity",
  "type": "object",
  "properties": {
    "receiving_user_id": {
      "type": "string",
      "description": "ID of the user who receives this notification"
    },
    "type": {
      "type": "string",
      "enum": [
        "upvote",
        "comment",
        "approved",
        "streak"
      ],
      "description": "Type of activity notification"
    },
    "actor_alter_ego": {
      "type": "string",
      "description": "Alter-ego name of the user who triggered the activity"
    },
    "task_prompt_text": {
      "type": "string",
      "description": "The prompt text of the related task"
    },
    "points_earned": {
      "type": "number",
      "description": "Points earned (for approved type)"
    },
    "streak_days": {
      "type": "number",
      "description": "Streak length in days (for streak type)"
    },
    "is_read": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user has read this notification"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional additional description or context for this activity"
    }
  },
  "required": [
    "receiving_user_id",
    "type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.receiving_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.receiving_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}