{
  "name": "PendingTask",
  "type": "object",
  "properties": {
    "prompt_text": {
      "type": "string",
      "description": "The suggested challenge prompt"
    },
    "category": {
      "type": "string",
      "enum": [
        "photography",
        "fitness",
        "exploration",
        "food",
        "art",
        "social",
        "nature",
        "culture",
        "wildcard",
        "creative"
      ],
      "description": "Challenge category"
    },
    "submitted_by_id": {
      "type": "string",
      "description": "User ID of the submitter"
    },
    "submitted_by_name": {
      "type": "string",
      "description": "Alter-ego or display name of submitter"
    },
    "upvotes": {
      "type": "number",
      "default": 0,
      "description": "Number of community upvotes"
    },
    "voters": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of user IDs who upvoted"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "promoted",
        "rejected"
      ],
      "default": "pending",
      "description": "Current status of the pending task"
    }
  },
  "required": [
    "prompt_text",
    "category",
    "submitted_by_id"
  ],
  "rls": {
    "create": {
      "data.submitted_by_id": "{{user.id}}"
    },
    "read": {
      "user_condition": {
        "id": {
          "$exists": true
        }
      }
    },
    "update": {
      "$or": [
        {
          "data.submitted_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.submitted_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}